{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "MassTransit": "Fatal",
        "MassTransit.Transports": "Fatal",
        "MassTransit.RabbitMqTransport": "Fatal",
        "MassTransit.Context": "Fatal",
        "MassTransit.Observability": "Fatal",
        "KLIM.Events.Service.Infrastructure.Outbox": "Information",
        "KLIM.Events.Service.Infrastructure.ChangeTracking": "Information"
      }
    },
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "@m like '%SENT%'"
        }
      },
      {
        "Name": "ByExcluding", 
        "Args": {
          "expression": "@m like '%KLIM.Events.Messaging.Contracts%'"
        }
      },
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "@m like '%Version=1.0.0.0%'"
        }
      }
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/outbox-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 10,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "Database": {
    "ConnectionString": "Server=klim-sql.2e340c2a848b.database.windows.net;Database=KLIM_IM_TK;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True;Authentication=Active Directory Default",
    "UseAzureAd": true
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest",
    "ExchangeName": "klim.events",
    "RoutingKeyPrefix": "klim.events",
    "DataChangeRoutingKeyTemplate": "{prefix}.{entity}.{operation}.{version}",
    "DomainNotificationRoutingKey": "{prefix}.domain.notification.v1",
    "DeadLetterSuffix": "dlq"
  },
  "MassTransit": {
    "Outbox": {
      "Enabled": true,
      "DeliveryIntervalSeconds": 2,
      "BatchSize": 50,
      "MaxConcurrentDispatches": 5,
      "RetentionDays": 7,
      "CleanupIntervalHours": 6,
      "PayloadMonitoring": {
        "MaxPayloadSizeMB": 2,
        "LargePayloadThresholdKB": 500,
        "MaxTextFieldLengthKB": 10,
        "LogPayloadSizes": true
      }
    }
  },
  "ChangeTracking": {
    "PollingIntervalSeconds": 5,
    "BatchSize": 100,
    "Tables": [
      { "Schema": "dbo", "Name": "Issuers", "Pk": "IssuerID" },
      { "Schema": "dbo", "Name": "Deals", "Pk": "DealID" }
    ]
  },
  "Health": {
    "Port": 8080
  }
}


