{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "MassTransit": "Fatal",
        "MassTransit.Transports": "Fatal",
        "MassTransit.RabbitMqTransport": "Fatal",
        "MassTransit.Context": "Fatal",
        "MassTransit.Observability": "Fatal",
        "KLIM.Events.Service.Infrastructure.Outbox": "Debug"
      }
    },
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "@m like '%SENT%'"
        }
      },
      {
        "Name": "ByExcluding", 
        "Args": {
          "expression": "@m like '%KLIM.Events.Messaging.Contracts%'"
        }
      },
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "@m like '%Version=1.0.0.0%'"
        }
      }
    ]
  }
}
