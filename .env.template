# =============================================================================
# KLIM.Events - Unified Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure your specific values
# Supports both Production and Development environments

# =============================================================================
# VERSION CONTROL
# =============================================================================
VERSION=latest

# =============================================================================
# APPLICATION ENVIRONMENT  
# =============================================================================
# Options: Development, Production
# Uncomment one of the following configurations:

# PRODUCTION CONFIGURATION (Default)
DOTNET_ENVIRONMENT=Production

# DEVELOPMENT CONFIGURATION (Uncomment for development)
# DOTNET_ENVIRONMENT=Development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Azure SQL Database connection string (same for both environments)
DATABASE__CONNECTIONSTRING=Server=klim-sql.2e340c2a848b.database.windows.net;Database=KLIM_IM_TK;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True;Authentication=Active Directory Default

# Use Azure AD authentication (recommended)
DATABASE__USEAZUREAD=true

# =============================================================================
# AZURE AD AUTHENTICATION (Optional - uses DefaultAzureCredential by default)
# =============================================================================
# Option 1: Use DefaultAzureCredential (recommended for local development)
# Just run: az login
# The service will automatically use your logged-in Azure credentials

# Option 2: Use Service Principal (for production/CI/CD)
# Uncomment and configure the following for service principal authentication:
# AZURE_CLIENT_ID=your-service-principal-client-id
# AZURE_CLIENT_SECRET=your-service-principal-secret
# AZURE_TENANT_ID=your-azure-tenant-id

# =============================================================================
# RABBITMQ CONFIGURATION
# =============================================================================
# External RabbitMQ (Production/Default Configuration)
# Uses existing RabbitMQ container shared with KLIM.Integrations
# Container: competent_burnell, Management UI: http://localhost:15672 (guest/guest)
RABBITMQ__HOST=host.docker.internal
RABBITMQ__USERNAME=guest
RABBITMQ__PASSWORD=guest
RABBITMQ__EXCHANGENAME=klim.events
RABBITMQ__ROUTINGKEYPREFIX=klim.events

# DEVELOPMENT ALTERNATIVE (Uncomment for development isolation)
# Uses separate exchange names to avoid interfering with production
# RABBITMQ__EXCHANGENAME=klim.events.dev
# RABBITMQ__ROUTINGKEYPREFIX=klim.events.dev

# Local Development RabbitMQ (Uncomment if using separate dev container)
# RABBITMQ__HOST=rabbitmq-dev
# RABBITMQ__USERNAME=dev
# RABBITMQ__PASSWORD=dev123

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# PRODUCTION SETTINGS (Default)
CHANGETRACKING__POLLINGINTERVALSECONDS=5
CHANGETRACKING__BATCHSIZE=100

# DEVELOPMENT SETTINGS (Uncomment for development debugging)
# Slower polling and smaller batches for better debugging experience
# CHANGETRACKING__POLLINGINTERVALSECONDS=10
# CHANGETRACKING__BATCHSIZE=50

# =============================================================================
# OUTBOX CONFIGURATION
# =============================================================================
# PRODUCTION SETTINGS (Default)
MASSTRANSIT__OUTBOX__ENABLED=true
MASSTRANSIT__OUTBOX__DELIVERYINTERVALSECONDS=2
MASSTRANSIT__OUTBOX__BATCHSIZE=50
MASSTRANSIT__OUTBOX__MAXCONCURRENTDISPATCHES=5
MASSTRANSIT__OUTBOX__RETENTIONDAYS=7
MASSTRANSIT__OUTBOX__CLEANUPINTERVALHOURS=6

# DEVELOPMENT SETTINGS (Uncomment for development)
# Reduced concurrency and retention for development debugging
# MASSTRANSIT__OUTBOX__DELIVERYINTERVALSECONDS=5
# MASSTRANSIT__OUTBOX__BATCHSIZE=25
# MASSTRANSIT__OUTBOX__MAXCONCURRENTDISPATCHES=2
# MASSTRANSIT__OUTBOX__RETENTIONDAYS=3

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
# Port configuration (avoids conflicts with KLIM.Integrations)
HEALTH__PORT=8080
EVENTS_HEALTH_PORT=8080

# DEVELOPMENT PORT (Uncomment if running alongside other services)
# EVENTS_HEALTH_PORT=8081

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# PRODUCTION LOGGING (Default - Less Verbose)
SERILOG__MINIMUMLEVEL__DEFAULT=Information
SERILOG__MINIMUMLEVEL__OVERRIDE__MICROSOFT=Warning

# DEVELOPMENT LOGGING (Uncomment for more verbose logging)
# SERILOG__MINIMUMLEVEL__DEFAULT=Debug
# SERILOG__MINIMUMLEVEL__OVERRIDE__MICROSOFT=Information
# SERILOG__MINIMUMLEVEL__OVERRIDE__MASSTRANSIT=Warning
# SERILOG__MINIMUMLEVEL__OVERRIDE__KLIM_EVENTS_SERVICE=Debug

# =============================================================================
# QUICK CONFIGURATION GUIDE
# =============================================================================
# 
# FOR PRODUCTION:
# 1. Keep default settings above
# 2. Run: az login (for Azure AD)
# 3. Run: .\deploy.ps1 deploy
#
# FOR DEVELOPMENT:
# 1. Change DOTNET_ENVIRONMENT=Development
# 2. Uncomment development RabbitMQ settings (*dev exchange names)
# 3. Uncomment development logging settings
# 4. Optionally uncomment development performance settings for debugging
# 5. Run: .\deploy.ps1 deploy
#
# =============================================================================