# KLIM.Events Service Environment Configuration
# Copy this file to create environment-specific configurations

# Consolidated Database Configuration (Used by both ChangeTracking and Outbox services)
# NOTE: Connection string uses "Authentication=Active Directory Default" for Azure AD authentication
# This means Azure AD credentials are automatically handled by the DefaultAzureCredential chain
DATABASE__CONNECTIONSTRING=Server=klim-sql.2e340c2a848b.database.windows.net;Database=KLIM_IM_TK;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True;Authentication=Active Directory Default
DATABASE__USEAZUREAD=true

# ChangeTracking Configuration (Service-specific settings only)
CHANGETRACKING__POLLINGINTERVALSECONDS=5
CHANGETRACKING__BATCHSIZE=100

# RabbitMQ Configuration
MASSTRANSIT__RABBITMQ__HOST=localhost
MASSTRANSIT__RABBITMQ__PORT=5672
MASSTRANSIT__RABBITMQ__VIRTUALHOST=/
MASSTRANSIT__RABBITMQ__USERNAME=guest
MASSTRANSIT__RABBITMQ__PASSWORD=guest

# Outbox Configuration (Service-specific settings only - no connection string needed)
MASSTRANSIT__OUTBOX__ENABLED=true
MASSTRANSIT__OUTBOX__DELIVERYINTERVALSECONDS=2
MASSTRANSIT__OUTBOX__BATCHSIZE=50
MASSTRANSIT__OUTBOX__MAXCONCURRENTDISPATCHES=5
MASSTRANSIT__OUTBOX__RETENTIONDAYS=7
MASSTRANSIT__OUTBOX__CLEANUPINTERVALHOURS=6

# Health Check Configuration
HEALTH__PORT=8080

# Logging Configuration (Serilog minimum level)
SERILOG__MINIMUMLEVEL__DEFAULT=Information

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# Optional: Override specific logging levels
# SERILOG__MINIMUMLEVEL__OVERRIDE__Microsoft=Warning
# SERILOG__MINIMUMLEVEL__OVERRIDE__MassTransit=Fatal
# SERILOG__MINIMUMLEVEL__OVERRIDE__KLIM.Events.Service.Infrastructure.Outbox=Information
# SERILOG__MINIMUMLEVEL__OVERRIDE__KLIM.Events.Service.Infrastructure.ChangeTracking=Information